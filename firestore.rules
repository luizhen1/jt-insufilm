rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /agendamentos/{appointmentId} {
      // O formulário público pode criar pedidos; somente usuários autenticados
      // podem consultar ou administrar os documentos.
      allow create: if validAppointment(request.resource.data);
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pendente', 'confirmado', 'concluido', 'cancelado'];
      allow delete: if false;
    }

    function validAppointment(data) {
      return data.keys().hasAll([
          'clienteNome', 'clienteTelefone', 'veiculo', 'tipoPelicula',
          'dataAgendamento', 'horario', 'status', 'criadoEm'
        ])
        && data.keys().hasOnly([
          'clienteNome', 'clienteTelefone', 'veiculo', 'tipoPelicula',
          'dataAgendamento', 'horario', 'status', 'criadoEm'
        ])
        && data.clienteNome is string && data.clienteNome.size() > 0
        && data.clienteTelefone is string && data.clienteTelefone.size() > 0
        && data.veiculo is string && data.veiculo.size() > 0
        && data.tipoPelicula is string
        && data.dataAgendamento is string
        && data.horario is string
        && data.status in ['pendente', 'confirmado']
        && data.criadoEm == request.time;
    }
  }
}
